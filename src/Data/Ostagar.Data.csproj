<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The data layer serves the hosts that configure it: it reads connection strings from
         configuration, registers itself into a service collection, and is the assembly `dotnet ef`
         loads at design time. Keeping those out would mean either duplicating them into every host or
         moving the tenancy guards away from the schema they protect. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Ostagar.Core.csproj" />
    <ProjectReference Include="..\Ledger\Ostagar.Ledger.csproj" />
    <ProjectReference Include="..\Platform\Ostagar.Platform.csproj" />
    <ProjectReference Include="..\Modules\CashBook\Ostagar.Modules.CashBook.csproj" />
  </ItemGroup>

</Project>
