<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>ostagar-api</UserSecretsId>
    <!-- Program must stay public so the integration host boots the identical composition root the
         deployment does. CA1515 would make it internal, which is exactly how an untestable DI
         container hides: the legacy app compiled while 22 registrations were commented out. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Ostagar.Core.csproj" />
    <ProjectReference Include="..\Data\Ostagar.Data.csproj" />
    <ProjectReference Include="..\Ledger\Ostagar.Ledger.csproj" />
    <ProjectReference Include="..\Platform\Ostagar.Platform.csproj" />
    <ProjectReference Include="..\Modules\CashBook\Ostagar.Modules.CashBook.csproj" />
    <ProjectReference Include="..\Modules\Inventory\Ostagar.Modules.Inventory.csproj" />
    <ProjectReference Include="..\Modules\Payroll\Ostagar.Modules.Payroll.csproj" />
    <ProjectReference Include="..\Modules\Production\Ostagar.Modules.Production.csproj" />
    <ProjectReference Include="..\Modules\Purchasing\Ostagar.Modules.Purchasing.csproj" />
    <ProjectReference Include="..\Modules\Sales\Ostagar.Modules.Sales.csproj" />
  </ItemGroup>

</Project>
